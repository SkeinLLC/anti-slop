{
  "name": "anti-slop",
  "displayName": "Anti-Slop",
  "description": "Flags AI-slop patterns in markdown and plain text: banned vocab, em dashes, negative parallelisms, rule of three, parataxis runs, and the rest.",
  "version": "0.1.6",
  "publisher": "SkeinLLC",
  "license": "MIT",
  "engines": {
    "vscode": "^1.85.0",
    "node": ">=18"
  },
  "categories": [
    "Linters",
    "Other"
  ],
  "keywords": [
    "linter",
    "ai",
    "writing",
    "markdown",
    "anti-slop",
    "prose"
  ],
  "repository": {
    "type": "git",
    "url": "git+https://github.com/SkeinLLC/anti-slop.git"
  },
  "bugs": {
    "url": "https://github.com/SkeinLLC/anti-slop/issues"
  },
  "homepage": "https://github.com/SkeinLLC/anti-slop#readme",
  "main": "./out/vscode/extension.js",
  "bin": {
    "antislop": "./bin/antislop.js"
  },
  "activationEvents": [
    "onLanguage:markdown",
    "onLanguage:plaintext",
    "onLanguage:mdx",
    "onLanguage:asciidoc",
    "onLanguage:tex",
    "onLanguage:latex"
  ],
  "contributes": {
    "configuration": {
      "title": "Anti-Slop",
      "properties": {
        "antislop.enable": {
          "type": "boolean",
          "default": true,
          "description": "Enable the Anti-Slop linter."
        },
        "antislop.configPath": {
          "type": "string",
          "default": ".antislop.yml",
          "description": "Workspace-relative path to the config file."
        },
        "antislop.preset": {
          "type": "string",
          "enum": [
            "default",
            "cti",
            "marketing",
            "off"
          ],
          "default": "default",
          "description": "Built-in preset to apply when no config file is found."
        },
        "antislop.runOn": {
          "type": "string",
          "enum": [
            "change",
            "save",
            "manual"
          ],
          "default": "save",
          "description": "When to run the linter."
        },
        "antislop.severity": {
          "type": "string",
          "enum": [
            "error",
            "warning",
            "information",
            "hint"
          ],
          "default": "warning",
          "description": "Default diagnostic severity for rule violations."
        },
        "antislop.maxIssuesPerFile": {
          "type": "number",
          "default": 500,
          "description": "Cap on diagnostics per file to keep the editor responsive."
        }
      }
    },
    "commands": [
      {
        "command": "antislop.lintFile",
        "title": "Anti-Slop: Lint Current File",
        "category": "Anti-Slop"
      },
      {
        "command": "antislop.scanWorkspace",
        "title": "Anti-Slop: Scan Workspace",
        "category": "Anti-Slop"
      },
      {
        "command": "antislop.createConfig",
        "title": "Anti-Slop: Create .antislop.yml in Workspace",
        "category": "Anti-Slop"
      },
      {
        "command": "antislop.showReport",
        "title": "Anti-Slop: Show File Report",
        "category": "Anti-Slop"
      }
    ]
  },
  "scripts": {
    "build": "tsc -p .",
    "watch": "tsc -p . -w",
    "test": "vitest run",
    "test:watch": "vitest",
    "lint": "node bin/antislop.js lint README.md docs/*.md",
    "package": "vsce package --no-dependencies",
    "publish": "vsce publish --no-dependencies"
  },
  "devDependencies": {
    "@types/node": "^20.11.0",
    "@types/vscode": "^1.85.0",
    "@vscode/vsce": "^2.24.0",
    "typescript": "^5.4.0",
    "vitest": "^1.6.0"
  },
  "icon": "images/icon.png"
}
